# Root aliases, quoted aliases, escaped whitespace, comments, and continuation.
Host zeta alpha "quoted alias" escaped\ alias Foo foo wildcard* host? [class] !negated -unsafe
Host=equals-form "hash#alias" escaped\#hash # unquoted comment
Host continued-\
alias # comment after a continued line

Include includes/*.conf
Include ~/.ssh/tilde.conf

Match exec "false"
    Include excluded.conf

Host after-match
